    <!-- Hero Section: The Problem & Promise -->
    <section class="hero" id="home">
        <div class="container">
            <h1>When Adulting Gets Too Hard,<br>You Don't Need Permission to Play</h1>
            <p class="tagline">Curious Hands. Creative Heart.</p>
            <p>Step into a world where every stitch tells a story and imagination isn't optional! We give you permission to play. Life requires it. 
    </section>

